{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": { "channel": "chrome", "headless": true },
    "contextOptions": {
      "viewport": { "width": 1440, "height": 1000 },
      "offline": true,
      "reducedMotion": "reduce"
    }
  },
  "allowUnrestrictedFileAccess": true,
  "snapshot": { "mode": "none" }
}
